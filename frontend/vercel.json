{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://phixora-production.up.railway.app/$1" },
    { "source": "/uploads/(.*)", "destination": "https://phixora-production.up.railway.app/uploads/$1" },
    { "source": "/outputs/(.*)", "destination": "https://phixora-production.up.railway.app/outputs/$1" },
    { "source": "/((?!assets|api|uploads|outputs).*)", "destination": "/index.html" }
  ]
}
